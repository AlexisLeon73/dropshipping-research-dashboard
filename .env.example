# Copy this file to .env and fill in what you have.
# Nothing here is required to run the Google Trends part of the dashboard.

# --- Google Trends (pytrends) ---
# No API key needed. Google may still rate-limit aggressively (HTTP 429);
# the app retries with backoff and caches results locally.
GOOGLE_TRENDS_HL=en-US
GOOGLE_TRENDS_GEO=
GOOGLE_TRENDS_CACHE_TTL_HOURS=12

# --- Reddit ---
# Create a "script" app at https://www.reddit.com/prefs/apps to get these.
# Uses the OAuth2 client_credentials grant (no Reddit account login needed,
# just the app's own client id/secret).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=product-research-dashboard/0.1 by yourusername
REDDIT_CACHE_TTL_HOURS=6

# --- Meta Ads Library ---
# Create an app at https://developers.facebook.com and generate an access
# token with Ad Library API access (this is the official ads_archive
# endpoint, not a scrape of the public ad library website).
META_ACCESS_TOKEN=
# JSON array string of ISO country codes to search, as the Graph API
# expects it — this is a required param on every ads_archive request.
META_AD_REACHED_COUNTRIES=["US"]
META_CACHE_TTL_HOURS=6

# --- App settings ---
DB_PATH=data/dashboard.db
MAX_TERMS_PER_SEARCH=10
